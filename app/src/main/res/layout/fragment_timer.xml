<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <Button
        android:id="@+id/btn_timer_session"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_modern_chip"
        android:text="当前分组"
        android:textAllCaps="false"
        android:textColor="@color/modern_text"
        android:textSize="13sp" />

    <com.dctimerble.pro.view.SmartCubeImageView
        android:id="@+id/iv_scramble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/app_name" />

    <com.dctimerble.pro.view.SmartCube3DView
        android:id="@+id/gl_cube"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:contentDescription="@string/app_name" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:visibility="gone"
        android:indeterminateTint="#dd007aff"
        android:indeterminateTintMode="src_atop"
        style="?android:attr/progressBarStyleSmall" />

    <TextView
        android:id="@+id/tv_multi_phase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="5dp"
        android:textSize="18sp"
        android:gravity="right"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_scramble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/modern_secondary_text"
        android:textSize="16sp"
        android:background="@drawable/bg_modern_surface" />

    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/modern_text"
        android:textSize="58sp"
        android:fontFamily="sans"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/tv_stat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="8dp"
        android:textSize="14sp"
        android:textColor="@color/modern_secondary_text"
        android:padding="10dp"
        android:background="@drawable/bg_modern_surface" />

    <TextView
        android:id="@+id/tv_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="5dp"
        android:textSize="14sp"
        android:textColor="@color/colorText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/bt_left"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:background="@color/transparent"
            android:src="@drawable/ic_left"
            android:visibility="gone" />

        <Button
            android:id="@+id/bt_scramble"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_modern_button"
            android:textColor="@color/modern_surface"
            android:textSize="15sp"
            android:minHeight="48dp"
            android:elevation="3dp"
            android:shadowColor="@color/colorBackground"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:textAllCaps="false" />

        <ImageButton
            android:id="@+id/bt_right"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:background="@color/transparent"
            android:src="@drawable/ic_right"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
